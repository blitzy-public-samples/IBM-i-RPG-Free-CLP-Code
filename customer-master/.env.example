# Environment template for the customer-master Docker Compose stack.
# Copy it to .env next to docker-compose.yml (cp .env.example .env); .env is git-ignored: never commit it.
# Every value below is the demo default docker-compose.yml already supplies, so an unedited copy changes nothing.
# The demo users and the database password are for local demos only; override them for anything shared.
# Format: NAME=value, each comment on its own line. Compose strips surrounding quotes; an inline comment must follow a space (NAME=value # note) or a closing quote, else the # is part of the value.
# Unquoted and double-quoted values expand $NAME and ${NAME}; single-quote a value holding a literal $ (NAME='a$b'), or Compose substitutes the variable (blank when unset).

# --- Database: datasource URL, Flyway and the generator; also the db service's POSTGRES_DB/USER/PASSWORD ---
# PostgreSQL host: the Compose service name.
DB_HOST=db
# PostgreSQL port inside the Compose network.
DB_PORT=5432
# Database name, created by the db service.
DB_NAME=customermaster
# The one role for the API, Flyway and the generator; it owns custmast_id_seq, as the generator's ALTER SEQUENCE needs.
# Compose-only default: application.yml has none.
DB_USER=customermaster
# Password of DB_USER. Compose-only demo default: application.yml has none.
DB_PASSWORD=customermaster-demo
# Schema of every table, applied through the JDBC currentSchema and spring.flyway.schemas; it replaces the hard-coded IBM i library names.
DB_SCHEMA=customer_master
# customer-master.db.lock-timeout: how long an add or update waits for a lock (for example during a generator load) before 409 DEM1001, and how often a search or get waiting on a table lock re-checks it; keep it below the 45-second database socket bound, or the API refuses to start.
DB_LOCK_TIMEOUT=5s
# Flyway locations. The Compose default adds db/seed, the V5 seed of 300 customers; application.yml alone uses classpath:db/migration.
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- Users: customer-master.security.users[0] and [1], HTTP Basic sign-in for the UI and the API ---
# Usernames must be 1-18 characters of A-Z, a-z, 0-9, '.', '_' or '-' and must not be *SYSTEM*, and passwords must be at most 72 bytes in UTF-8 (a non-ASCII character counts for two to four), or the API refuses to start.
# e2e signs in as these users: the Compose e2e service receives them from docker-compose.yml; host-run Playwright reads CM_* from its shell.
# k6 signs in with K6_USER/K6_PASSWORD below: set those to match if you override the inquiry user.
# Role INQUIRY (source mode I): search and display.
CM_INQUIRY_USER=inquiry
CM_INQUIRY_PASSWORD=inquiry-demo
# Role MAINTENANCE (source mode M): search, display, edit and add.
CM_MAINTENANCE_USER=sales
CM_MAINTENANCE_PASSWORD=sales-demo

# --- Address validation: AddressValidationAutoConfiguration, AddressValidationProperties, AddressStandardizationService ---
# false turns address standardization off, so maintenance runs exactly the 5250 field rules.
ADDRESS_VALIDATION_ENABLED=true
# stub (deterministic, the default) or usps. Set usps only after the checklist in docs/developer-guide.md: USPS Web Tools was retired on 2026-01-25.
ADDRESS_VALIDATION_CLIENT=stub
# USPS Web Tools endpoint, the one the IBM i service program called.
USPS_BASE_URL=https://secure.shippingapis.com/ShippingAPI.dll
# USPS user id, replacing the USPS_ID data area. Required when ADDRESS_VALIDATION_CLIENT=usps (startup fails if empty). Put it in .env only.
USPS_USER_ID=
# USPS password, replacing the USPS_PWD data area (the source notes USPS seemed to ignore it). Put it in .env only.
USPS_PASSWORD=
# Connect and read timeouts of the USPS HTTP client, as Spring durations.
USPS_CONNECT_TIMEOUT=5s
USPS_READ_TIMEOUT=10s

# --- Generator: docker compose --profile tools run --rm generator, read through application-generator.yml ---
# A command-line flag (--count, --start-id, --csz-file, --seed) wins over the matching variable below.
# Rows to load, replacing the LOADCUST2 &NUM parameter: 1 up to 1,679,616 minus the ordinal of the start id.
GENERATOR_COUNT=300
# First customer id, 4 characters of A-Z or 0-9. Blank means automatic: 1001, or AAAA when the count exceeds 385,245.
GENERATOR_START_ID=
# City/state/ZIP CSV: the bundled sample, or /data/csz.csv for a full file placed in ./data (see data/README.md).
GENERATOR_CSZ_FILE=classpath:generator/csz-sample.csv
# Random seed. Blank means random; a number makes runs repeatable.
GENERATOR_SEED=

# --- Host ports and test runners ---
# Host port of the UI (nginx): http://localhost:8080.
FRONTEND_PORT=8080
# Host address of the UI port: 127.0.0.1 keeps it on this machine, localhost URLs included; 0.0.0.0 (every interface) or one interface's IP shares it, so override the demo users and the database password first.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Host port of the API: Swagger UI at http://localhost:8081/swagger-ui.html, curl and other host-run tools.
API_PORT=8081
# Host address of the API port, read like FRONTEND_BIND_ADDRESS; keep 127.0.0.1 when sharing the UI, so other machines reach the API only through its /api proxy.
API_BIND_ADDRESS=127.0.0.1
# COMPOSE_PROJECT_NAME, the Compose project name, is not set here; unset, it is this folder's name (customer-master). It prefixes the containers, the network and the pgdata volume, and names the backend image <name>-app:local.
# Add it to .env, with its own FRONTEND_PORT and API_PORT, to run a second stack on one Docker host. An exported COMPOSE_PROJECT_NAME or `docker compose -p` wins over .env.
# Base URL for e2e/playwright.config.ts when Playwright runs on the host; the Compose e2e service defaults to http://frontend.
# Left commented so a copied .env never points the containerised e2e run at localhost.
# BASE_URL=http://localhost:8080
# Playwright trace mode for e2e/playwright.config.ts: unset or off records none; on or retain-on-failure opt in, refused unless the CM_* users are the demo defaults, because a trace records entered passwords and Authorization headers.
# Read only from the shell or `docker compose --profile e2e run --rm -e E2E_TRACE=retain-on-failure e2e`, never from this file, so it stays commented.
# E2E_TRACE=retain-on-failure
# perf/k6/search-1m.js (Compose k6 service): the API base URL inside the Compose network and the user k6 signs in as.
K6_BASE_URL=http://app:8080
K6_USER=inquiry
K6_PASSWORD=inquiry-demo

# --- Memory budgets: the mem_limit of each Compose service, in Docker size units (m, g) ---
# Each default is at least 1.75 times the peak measured on the 1,000,000-row load, the k6 run and the e2e run; raise one whose container is OOM-killed (docker inspect -f '{{.State.OOMKilled}}').
# PostgreSQL: peak 1.4 GiB after the 1,000,000-row load and k6, mostly page cache of the WAL, the table and its indexes (347 MB); 3g also leaves room to cache the largest, 1,679,616-row data set.
MEM_LIMIT_DB=3g
# API JVM: peak 508 MiB under k6; with no heap flags the JVM takes a quarter of the limit as its heap (256 MiB at 1g).
MEM_LIMIT_APP=1g
# nginx with its one worker: peak 9 MiB, the e2e run and long API waits included.
MEM_LIMIT_FRONTEND=32m
# Generator JVM, which streams the rows to COPY: peak 1.0 GiB on the 1,000,000-row load; heap a quarter of the limit (512 MiB at 2g).
MEM_LIMIT_GENERATOR=2g
# k6: peak 38 MiB at the run's 20 VUs and 73 MiB with all 100 VUs the scenario may start on a slow host.
MEM_LIMIT_K6=128m
# Playwright with Chromium: peak 857 MiB over npm ci and the five specs.
MEM_LIMIT_E2E=1536m
