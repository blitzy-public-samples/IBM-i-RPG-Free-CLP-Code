{
  // App project for `tsc -b`, the type check that `npm run build` runs before
  // `vite build`. It covers everything under src/: the browser app, the
  // colocated *.test.ts(x) suites, src/test/* and the generated
  // src/api/schema.d.ts. Node tooling (vite.config.ts) is type-checked by the
  // referenced tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    // Strictness. `strict` and `noUncheckedIndexedAccess` are mandatory for
    // this project: an indexed read such as `items[0]` is typed `T | undefined`
    // and has to be narrowed before use.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Bundler mode. Vite transpiles each file on its own, so type-only imports
    // must be written `import type` (verbatimModuleSyntax, which also turns on
    // the isolatedModules checks) and every file is a module. Imports stay
    // extensionless, as Vite resolves them, so allowImportingTsExtensions is
    // left off.
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // `types` is deliberately unset. Ambient Vite types come from
    // src/vite-env.d.ts (`/// <reference types="vite/client" />`); test files
    // import describe/it/expect/vi from 'vitest' explicitly (Vitest runs with
    // globals off); jest-dom matcher types come from
    // `import '@testing-library/jest-dom/vitest'` in src/test/setup.ts.

    // Vite does the bundling, so this project only type-checks. Build mode
    // still records its incremental state; it goes under node_modules/.tmp so
    // `tsc -b` writes nothing into the source tree.
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
